{
  "name": "@zhangwanli/zentao-cli",
  "version": "0.1.0",
  "description": "让开发者和 coding agent 读写禅道（开源版 16.x）单据的命令行工具",
  "keywords": [
    "zentao",
    "禅道",
    "cli",
    "agent",
    "coding-agent",
    "bug-tracker"
  ],
  "homepage": "https://github.com/zhangwanli09/zentao-cli#readme",
  "bugs": {
    "url": "https://github.com/zhangwanli09/zentao-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangwanli09/zentao-cli.git"
  },
  "license": "MIT",
  "author": "zhangwanli",
  "type": "module",
  "bin": {
    "zentao": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "marked": "^18.1.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.20.0"
}
